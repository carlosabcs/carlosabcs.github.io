---
import type { PortfolioData } from '../i18n/types';

interface Props {
  labContent: PortfolioData['lab'];
}

const { labContent } = Astro.props;

const getBentoClasses = (index: number) => {
  if (index === 0) return "md:col-span-2 bg-surface-container-high p-8 flex flex-col justify-between border border-outline-variant/10 group hover:border-primary/50 transition-all";
  if (index === 1) return "md:col-span-2 bg-surface-container p-8 border border-outline-variant/10 hover:bg-surface-container-high transition-all flex flex-col justify-between";
  return "md:col-span-1 bg-surface-container p-8 border border-outline-variant/10 hover:bg-surface-container-high transition-all flex flex-col justify-between";
};
---

<section class="py-32 px-6 md:px-12 bg-surface" id="lab">
  <div class="max-w-6xl mx-auto">
    <div class="mb-20 text-center">
      <h2 class="text-[0.6875rem] uppercase tracking-[0.3em] font-bold text-primary mb-4">
        {labContent.sectionTitle}
      </h2>
      <h3 class="text-3xl font-bold font-headline text-on-surface">
        {labContent.header}
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-6 h-auto md:min-h-150">
      {labContent.items.map((item, index) => (
        <div class={getBentoClasses(index)}>
          <div>
            <div class={`flex items-start mb-6 ${index === 0 ? 'justify-between' : 'gap-4 items-center mb-4'}`}>
              <span class={`material-symbols-outlined text-primary ${index === 0 ? 'text-4xl mb-6' : ''}`}>
                {item.icon}
              </span>
              {index === 0 && (
                <span class="text-[0.625rem] font-mono text-outline uppercase">
                  {item.version}
                </span>
              )}
            </div>
            
            <h4 class={`${index === 0 ? 'text-2xl mb-4' : 'text-xl mb-2'} font-bold text-on-surface`}>
              {item.title}
            </h4>
            <p class="text-on-surface-variant text-sm leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <div>
            {item.tags && item.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {item.tags.map((tag) => (
                  <span class="text-[0.625rem] px-2 py-1 bg-surface-container-lowest text-outline uppercase tracking-widest font-bold">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            
            {item.linkText && (
              <button class="flex gap-3 items-center group/btn cursor-pointer">
                <span class="text-[0.6875rem] font-bold tracking-widest uppercase text-primary transition-colors group-hover/btn:text-primary-container">
                  {item.linkText}
                </span>
                <span class="material-symbols-outlined text-primary group-hover/btn:translate-x-1 group-hover/btn:text-primary-container transition-all">
                  arrow_forward
                </span>
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
