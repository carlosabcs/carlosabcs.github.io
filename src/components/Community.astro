---
import type { PortfolioData } from '../i18n/types';

interface Props {
  communityContent: PortfolioData['community'];
}

const { communityContent } = Astro.props;
---

<section class="py-32 px-6 md:px-12 bg-surface" id="community">
  <div class="max-w-6xl mx-auto">
    <div class="mb-20">
      <h2 class="text-[0.6875rem] uppercase tracking-[0.3em] font-bold text-primary mb-4">
        {communityContent.sectionTitle}
      </h2>
      <h3 class="text-3xl font-bold font-headline text-on-surface">
        {communityContent.header}
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {communityContent.items.map((item, index) => (
        <div class={`bg-surface-container-low p-8 border-l-2 group hover:bg-surface-container-high transition-all ${index % 2 === 0 ? 'border-primary' : 'border-outline'}`}>
          <div class="flex items-center gap-3 mb-6">
            <span class={`material-symbols-outlined ${index % 2 === 0 ? 'text-primary' : 'text-outline'}`}>
              {item.icon}
            </span>
            <span class="text-[0.625rem] font-bold uppercase tracking-widest text-outline">
              {item.category}
            </span>
          </div>
          <h4 class="font-bold text-lg mb-2 text-on-surface">
            {item.title}
          </h4>
          <p class="text-on-surface-variant text-xs leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
