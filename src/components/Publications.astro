---
import type { PortfolioData } from '../i18n/types';

interface Props {
  publicationsContent: PortfolioData['publications'];
}

const { publicationsContent } = Astro.props;
---

<section class="py-32 px-6 md:px-12 bg-surface-container-lowest" id="publications">
  <div class="max-w-4xl mx-auto">
    <div class="mb-16">
      <h2 class="text-[0.6875rem] uppercase tracking-[0.3em] font-bold text-primary mb-4">
        {publicationsContent.sectionTitle}
      </h2>
      <h3 class="text-3xl font-bold font-headline text-on-surface">
        {publicationsContent.header}
      </h3>
    </div>

    <div class="space-y-0 border-t border-outline-variant/20">
      {publicationsContent.items.map((item) => (
        <div class="group border-b border-outline-variant/20 py-10 flex flex-col md:flex-row justify-between gap-8 hover:bg-surface-container-low/50 transition-colors px-4 -mx-4">
          <div class="max-w-xl">
            <span class="text-[0.625rem] uppercase font-bold tracking-widest text-outline mb-2 block">
              {item.conference}, {item.year}
            </span>
            <h4 class="text-xl font-bold text-on-surface group-hover:text-primary transition-colors">
              {item.title}
            </h4>
            <p class="text-on-surface-variant text-sm mt-3 leading-relaxed">
              {item.description}
            </p>
          </div>
          
          <div class="flex items-start">
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-widest text-on-surface border border-outline-variant/30 px-4 py-2 hover:bg-primary hover:border-primary hover:text-on-primary transition-all cursor-pointer"
            >
              {item.linkText}
              <span class="material-symbols-outlined text-sm">open_in_new</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10">
      <a
        href={publicationsContent.viewAllUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-widest leading-none text-primary border-b border-transparent hover:border-primary transition-colors"
      >
        {publicationsContent.viewAllText}
        <span class="material-symbols-outlined text-[0.6875rem] leading-none">open_in_new</span>
      </a>
    </div>
  </div>
</section>
