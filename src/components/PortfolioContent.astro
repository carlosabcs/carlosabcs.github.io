---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar';
import Experience from './Experience.astro';
import Lab from './Lab.astro';
import Publications from './Publications.astro';
import Community from './Community.astro';
import { getI18n } from '../i18n/utils';
import type { SupportedLangs } from '../i18n/types';

interface Props {
  lang: SupportedLangs;
}

const { lang } = Astro.props;
const content = getI18n(lang);
---

<Layout title={content.meta.title} lang={lang}>
  <Navbar client:load lang={lang} navbarContent={content.nav} />

  <main class="min-h-screen flex items-center px-6 md:px-12 pt-24 pb-16">
    <div class="max-w-5xl">
      <span class="text-primary font-bold tracking-[0.2em] uppercase text-[0.6875rem] mb-6 block">
        {content.hero.location}
      </span>
      <h1 class="text-[3.5rem] md:text-[5rem] leading-[1.1] font-extrabold tracking-tighter mb-8 font-headline text-on-surface">
        {content.hero.title1} <br/>
        <span class="text-transparent bg-clip-text gradient-sheen">
          {content.hero.title2}
        </span>
      </h1>
      <p class="text-lg md:text-xl text-on-surface-variant max-w-2xl leading-relaxed mb-12">
        {content.hero.description}
      </p>
      <div class="flex flex-col md:flex-row gap-4">
        <button class="gradient-sheen text-on-primary-container font-bold px-8 py-4 uppercase tracking-widest text-[0.75rem] hover:opacity-90 transition-opacity cursor-pointer">
          {content.hero.cvButton}
        </button>
        <button class="border border-outline-variant/30 text-on-surface font-bold px-8 py-4 uppercase tracking-widest text-[0.75rem] hover:bg-surface-container-high transition-colors cursor-pointer">
          {content.hero.labButton}
        </button>
      </div>
    </div>
  </main>

  <Experience experienceContent={content.experience} />
  <Lab labContent={content.lab} />
  <Publications publicationsContent={content.publications} />
  <Community communityContent={content.community} />

  <footer class="bg-surface-container-lowest w-full py-20 border-t border-outline-variant/20 flex flex-col md:flex-row justify-between items-center px-6 md:px-12 gap-8">
    <div class="text-on-surface font-headline font-bold text-lg tracking-tighter">
      {content.footer.logo}
    </div>
    <div class="text-outline font-sans text-[0.625rem] tracking-widest uppercase">
      © {new Date().getFullYear()} {content.footer.copyright}
    </div>
    <div class="flex gap-8">
      <a href={content.footer.githubUrl} target="_blank" rel="noopener noreferrer" class="font-sans text-[0.6875rem] tracking-widest uppercase text-outline hover:text-primary transition-colors">
        {content.footer.githubText}
      </a>
      <a href={content.footer.linkedinUrl} target="_blank" rel="noopener noreferrer" class="font-sans text-[0.6875rem] tracking-widest uppercase text-outline hover:text-primary transition-colors">
        {content.footer.linkedinText}
      </a>
    </div>
  </footer>
</Layout>
