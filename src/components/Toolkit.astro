---
import type { PortfolioData } from '../i18n/types';

interface Props {
  toolkitContent: PortfolioData['toolkit'];
}

const { toolkitContent } = Astro.props;
---

<section class="py-32 px-6 md:px-12 bg-surface" id="toolkit">
  <div class="max-w-6xl mx-auto">
    <div class="mb-20">
      <!-- <h2 class="text-[0.6875rem] uppercase tracking-[0.3em] font-bold text-primary mb-4">
        {toolkitContent.sectionTitle}
      </h2> -->
      <h3 class="text-3xl font-bold font-headline text-on-surface">
        {toolkitContent.header}
      </h3>
    </div>

    <div class="space-y-10">
      {toolkitContent.blocks.map((block) => (
        <div class="space-y-2">
          <span class="block font-mono text-[0.6875rem] uppercase tracking-widest font-bold text-outline">
            {block.label}
          </span>
          <p class="text-on-surface-variant leading-relaxed">
            {block.items.join(" · ")}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
