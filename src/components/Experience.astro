---
import type { PortfolioData } from '../i18n/types';

interface Props {
  experienceContent: PortfolioData['experience'];
}

const { experienceContent } = Astro.props;
---

<section class="py-32 px-6 md:px-12 bg-surface-container-low" id="experience">
  <div class="max-w-6xl mx-auto">
    <div class="mb-20">
      <h3 class="text-3xl font-bold font-headline text-on-surface">
        {experienceContent.header}
      </h3>
    </div>

    <div class="space-y-24 border-l border-outline-variant/20 ml-4 md:ml-0">
      {experienceContent.roles.map((role, index) => (
        <div class="relative pl-6 md:pl-12 group">
          <div class={`absolute -left-1.25 top-0 w-2.5 h-2.5 transition-colors duration-300 ${index === 0 ? 'bg-primary' : 'bg-outline group-hover:bg-primary/70'}`}></div>
          
          <div class="mb-8 space-y-2">
              <h4 class="text-2xl font-bold text-on-surface">
                {role.title}
              </h4>
              {role.companyUrl ? (
                <a
                  href={role.companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:text-primary-container hover:underline underline-offset-4 decoration-1 transition-all text-lg"
                >
                  {role.company}
                </a>
              ) : (
                <span class="text-primary text-lg">{role.company}</span>
              )}
              <div>
                <span class="inline-block px-3 py-1.5 bg-surface-container-highest border border-outline-variant/30 text-[0.6875rem] uppercase font-mono text-on-surface tracking-widest font-bold">
                  {role.period}
                </span>
              </div>
            </div>

          <div class="space-y-6">
              <p class="text-on-surface-variant leading-relaxed">
                {role.description}
              </p>
              {role.highlights.length ? (
                <div class="space-y-2">
                  <span class="block font-mono text-[0.6875rem] uppercase tracking-widest font-bold text-outline">
                    {experienceContent.highlightsLabel}
                  </span>
                  <ul class="list-disc pl-5 space-y-2 marker:text-primary">
                    {role.highlights.map((highlight) => (
                      <li class="text-on-surface-variant leading-relaxed">{highlight}</li>
                    ))}
                  </ul>
                </div>
              ) : null}
              <div class="space-y-2">
                <span class="block font-mono text-[0.6875rem] uppercase tracking-widest font-bold text-outline">
                  {experienceContent.techLabel}
                </span>
                <p class="text-on-surface-variant leading-relaxed">
                  {role.tech.join(" · ")}
                </p>
              </div>
              {role.metrics.length ? (
                <div class="space-y-2">
                  <span class="block font-mono text-[0.6875rem] uppercase tracking-widest font-bold text-outline">
                    {experienceContent.metricsLabel}
                  </span>
                  <p class="leading-relaxed">
                    {role.metrics.map((metric, index) => (
                      <span>
                        {index > 0 && <span class="text-outline"> · </span>}
                        <span class="font-bold text-primary">{metric.value}</span>
                        <span class="text-on-surface-variant"> {metric.label}</span>
                      </span>
                    ))}
                  </p>
                </div>
              ) : null}
            </div>
        </div>
      ))}
    </div>
  </div>
</section>
